{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:slug(cv|arcade|holonet)", "destination": "/index.html" },
    { "source": "/:slug(cv|arcade|holonet)/", "destination": "/index.html" },
    { "source": "/work/:path*", "destination": "/index.html" }
  ]
}
